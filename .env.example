# ── DNSE OpenAPI ────────────────────────────────
DNSE_API_KEY=
DNSE_API_SECRET_KEY=

# ── vnstock ─────────────────────────────────────
VNSTOCK_API_KEY=

# ── Redis ───────────────────────────────────────
REDIS_HOST=redis_service
REDIS_PORT=6379
REDIS_DB=2

# ── vnstock source ──────────────────────────────
VNSTOCK_SOURCE=KBS
VNSTOCK_POLL_INTERVAL=3.0

# ── Preload ─────────────────────────────────────
PRELOAD_DIR=/app/data/preload/1m
PRELOAD_MONTHS=6
PRELOAD_CHUNK_DAYS=7
PRELOAD_DELAY=1.0
PRELOAD_MAX_RETRIES=3

# ── Binance WS ──────────────────────────────────
BINANCE_WS_BATCH_SIZE=300
BINANCE_SYMBOLS_FILE=/app/symbols.json

# ── FastAPI ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8100
