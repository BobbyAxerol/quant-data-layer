# ── DNSE OpenAPI ────────────────────────────────
DNSE_API_KEY=
DNSE_API_SECRET_KEY=

# ── vnstock ─────────────────────────────────────
VNSTOCK_API_KEY=

# ── Redis ───────────────────────────────────────
REDIS_HOST=redis_marketdata
REDIS_PORT=6379
REDIS_DB=0

# ── vnstock source ──────────────────────────────
VNSTOCK_SOURCE=KBS
VNSTOCK_POLL_INTERVAL=3.0

# ── Preload ─────────────────────────────────────
PRELOAD_DIR=/app/data/preload/1m
PRELOAD_MONTHS=6
PRELOAD_CHUNK_DAYS=7
PRELOAD_DELAY=1.0
PRELOAD_MAX_RETRIES=3
PRELOAD_DAILY_RUN_TIME=16:00
PRELOAD_API_FRESH_TOPUP=true
PRELOAD_API_TOPUP_MAX_LAG_MINUTES=1
PRELOAD_STRICT_FRESHNESS=false

# ── Binance WS ──────────────────────────────────
BINANCE_WS_BATCH_SIZE=100
BINANCE_WS_QUEUE_MAXSIZE=10000
BINANCE_WS_MAX_CONNS_PER_SOURCE=0
STREAM_STALE_SECONDS=180
STREAM_STRICT_FEED_HEALTH=false
BINANCE_SYMBOLS_FILE=/app/symbols.json
BINANCE_SPOT_SYMBOLS_FILE=/app/symbols_spot.json

# ── Diagnostics ─────────────────────────────────
VN_STRICT_LIVE_STREAMS=false

# ── Provider fallback ───────────────────────────
OKX_FALLBACK_ENABLED=true
OKX_FALLBACK_STALE_SECONDS=180
OKX_FALLBACK_PRIORITY_SYMBOLS=BTCUSDT,ETHUSDT

# ── FastAPI ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8100
